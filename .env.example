# === ML Service Environment Variables ===

# Groq API Key (обязателен для API режима)
GROQ_API_KEY=gsk_your_key_here

# Режим работы LLM (true = локальная модель, false = Groq API)
USE_LOCAL_LLM=false

# Путь к локальной модели GGUF (только для USE_LOCAL_LLM=true)
LOCAL_MODEL_PATH=/app/models/Meta-Llama-3-8B-Instruct.Q4_K_M.gguf
